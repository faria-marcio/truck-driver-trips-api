@TruckDriverTrips.Api_HostAddress = http://localhost:5010

@adminToken = replace-with-admin-jwt
@driverToken = replace-with-driver-jwt
@driverId = replace-with-driver-id
@truckId = replace-with-truck-id
@tripId = replace-with-trip-id

### List active trucks
GET {{TruckDriverTrips.Api_HostAddress}}/api/trucks
Authorization: Bearer {{driverToken}}
Accept: application/json

###

### Create a truck (admin)
POST {{TruckDriverTrips.Api_HostAddress}}/api/trucks
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "registrationNumber": "TRUCK-001",
  "make": "Volvo",
  "model": "FH"
}

###

### Assign a truck to a driver (admin)
PUT {{TruckDriverTrips.Api_HostAddress}}/api/trucks/assignments/{{driverId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "truckId": "{{truckId}}"
}

###

### Read the authenticated driver's current truck
GET {{TruckDriverTrips.Api_HostAddress}}/api/trucks/me
Authorization: Bearer {{driverToken}}
Accept: application/json

###

### List trips with optional filters and pagination
GET {{TruckDriverTrips.Api_HostAddress}}/api/trips?from=2026-08-01&to=2026-08-31&truckId=TRUCK-001&page=1&pageSize=25
Authorization: Bearer {{driverToken}}
Accept: application/json

###

### Get the authorized trip summary
GET {{TruckDriverTrips.Api_HostAddress}}/api/trips/summary?from=2026-08-01&to=2026-08-31&truckId=TRUCK-001
Authorization: Bearer {{driverToken}}
Accept: application/json

###

### Create a trip (omitted truckId uses the driver's current assignment)
POST {{TruckDriverTrips.Api_HostAddress}}/api/trips
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{
  "date": "2026-08-20",
  "startKm": 100.0,
  "endKm": 125.0,
  "pickupLocation": "A",
  "dropoffLocation": "B",
  "commissionAmount": 125.0,
  "bolNumber": "BOL-001",
  "fuelCostAmount": 30.0,
  "waitTimeMinutes": 15,
  "notes": "Optional notes"
}

###

### Get one trip
GET {{TruckDriverTrips.Api_HostAddress}}/api/trips/{{tripId}}
Authorization: Bearer {{driverToken}}
Accept: application/json

###

### Replace one trip
PUT {{TruckDriverTrips.Api_HostAddress}}/api/trips/{{tripId}}
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{
  "date": "2026-08-21",
  "truckId": "{{truckId}}",
  "startKm": 125.0,
  "endKm": 150.0,
  "pickupLocation": "B",
  "dropoffLocation": "C",
  "commissionAmount": 150.0,
  "bolNumber": "BOL-002",
  "fuelCostAmount": 35.0,
  "waitTimeMinutes": 0,
  "notes": "Updated notes"
}

###

### Delete one trip
DELETE {{TruckDriverTrips.Api_HostAddress}}/api/trips/{{tripId}}
Authorization: Bearer {{driverToken}}
